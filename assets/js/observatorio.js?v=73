function ensureContextTooltip(){
  if(contextTooltip)return contextTooltip;
  contextTooltip=document.createElement('div');
  contextTooltip.className='context-tooltip';contextTooltip.setAttribute('role','tooltip');contextTooltip.hidden=true;
  document.body.appendChild(contextTooltip);return contextTooltip
}
function showContextTooltip(btn){
  const tip=ensureContextTooltip(),r=btn.getBoundingClientRect();tip.textContent=btn.dataset.help||'';tip.hidden=false;
  tip.style.left='0px';tip.style.top='0px';const tr=tip.getBoundingClientRect();
  let left=r.right-tr.width;left=Math.max(10,Math.min(left,window.innerWidth-tr.width-10));
  let top=r.bottom+8;if(top+tr.height>window.innerHeight-10)top=r.top-tr.height-8;
  tip.style.left=`${left}px`;tip.style.top=`${Math.max(10,top)}px`;
}
function hideContextTooltip(){if(contextTooltip)contextTooltip.hidden=true}
function applyContextHelp(root=document){
  root.querySelectorAll('.acronym-help').forEach(x=>x.remove());
  const excluded='.filter-summary,.clear-filters,.guide-trigger,.brand,.nav-item,.theme-toggle';
  root.querySelectorAll(excluded+',.preview-actions button').forEach(el=>{el.classList.remove('has-context-help');el.querySelectorAll(':scope > .context-help').forEach(x=>x.remove())});
  const targets=root.querySelectorAll('.card,.kpi-card,.filter-control,.download-card,.format-card,.terms-card');
  targets.forEach(target=>{
    target.querySelectorAll(':scope > .context-help').forEach((x,i)=>{if(i>0)x.remove()});
    if(target.querySelector(':scope > .context-help'))return;
    const text=contextHelpText(target);if(!text)return;
    target.classList.add('has-context-help');
    const btn=document.createElement('button');btn.type='button';btn.className='context-help';btn.textContent='?';btn.dataset.help=text;
    btn.setAttribute('aria-label','Explicação deste elemento');
    btn.addEventListener('mouseenter',()=>showContextTooltip(btn));btn.addEventListener('mouseleave',()=>{if(document.activeElement!==btn)hideContextTooltip()});
    btn.addEventListener('focus',()=>showContextTooltip(btn));btn.addEventListener('blur',hideContextTooltip);
    btn.addEventListener('click',e=>{e.stopPropagation();if(contextTooltip&&!contextTooltip.hidden){hideContextTooltip();btn.blur()}else{showContextTooltip(btn)}});
    target.appendChild(btn)
  })
}
