function aggregate(rows){let uh=0,benef=0,pop=0,pib=0,ops=0,valor=0,fcus=0,fcuArea=0,used=0,sectors=0,missing=0,dom=0;for(const r of rows){uh+=r._uh;benef+=r._benef;pop+=r._pop;pib+=r._pib;ops+=r._ops;valor+=r._valor;fcus+=r._fcu;fcuArea+=r._fcuArea;used+=+r.setores_fcu_com_dado_entorno_utilizavel||0;sectors+=+r.setores_fcu||0;missing+=+r.setores_fcu_sem_dado_entorno_utilizavel||0;dom+=+r.entorno_dom_pesquisados||0}return{uh,benef,pop,pib,ops,valor,fcus,fcuArea,used,sectors,missing,dom,reach:pop?benef/pop*100:0,coverage:sectors?used/sectors*100:null,uhPib:pib?uh/(pib/1e6):0,present:rows.filter(r=>r._uh>0).length,withFcu:rows.filter(r=>+r.tem_fcu===1).length}}
