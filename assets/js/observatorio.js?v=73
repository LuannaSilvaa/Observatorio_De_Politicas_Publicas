}
function ensureChartType(id){
  const opt=currentVisualOption(id),allowed=allowedChartTypes(opt);
  if(!allowed.includes(visualChartTypes[id]))visualChartTypes[id]=allowed[0];
  return visualChartTypes[id];
}
function currentVisualOption(id){const key=visualSelections[id];return (visualOptionDefs[id]||[]).find(x=>x.key===key)||visualOptionDefs[id]?.[0]}
function visualMetricItems(rows,cfg,opt){
  const metric=(opt&&opt.metric)||cfg.value;
  const byMunicipality=state.uf.length===1||rows.length<=40;
  if(byMunicipality)return rows.map(r=>({key:placeLabel(r),value:Number(metric(r))||0})).sort((a,b)=>b.value-a.value).slice(0,10);
  const groups=new Map();
  for(const r of rows){const key=fullUf(r.uf)||r.regiao||'—',v=Number(metric(r))||0;if(!groups.has(key))groups.set(key,{sum:0,count:0});const g=groups.get(key);g.sum+=v;g.count++}
  const aggregate=(opt&&opt.aggregate)||cfg.aggregate||'sum';
