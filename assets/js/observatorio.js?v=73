      select.onchange=()=>{visualSelections[id]=select.value;refreshTypes();setVisualMode(id,visualModes[id],currentRows())};
      typeSelect.onchange=()=>{visualChartTypes[id]=typeSelect.value;renderVisualChart(id,currentRows(),cfg)};
      edit.onclick=()=>renderChartEditor(id);
