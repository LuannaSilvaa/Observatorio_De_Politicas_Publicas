function renderVisualChart(id,rows,cfg){
  const el=document.getElementById(id);if(!el)return;mapRenderTokens.set(id,(mapRenderTokens.get(id)||0)+1);
  const opt=currentVisualOption(id)||{key:'value',label:cfg.baseLabel,metric:cfg.value,format:v=>fmt.format(v),what:'indicador selecionado'};
  const s=chartSettings(id),items=chartItems(rows,{...cfg},opt,id),max=Math.max(1,...items.map(x=>x.value)),colors=chartColors(s),type=ensureChartType(id);
  const title=s.title.trim()||academicChartTitle(id,opt),subtitle=s.subtitle.trim()||academicChartSubtitle(rows);
  const cssVars=`--chart-font:${s.fontFamily};--chart-title-size:${s.titleSize}px;--chart-subtitle-size:${s.subtitleSize}px;--chart-body-size:${s.bodySize}px;--chart-axis-size:${s.axisSize}px;--chart-value-size:${s.valueSize}px;--chart-text:${s.textColor};--chart-bg:${s.imageBg};--plot-bg:${s.plotBg};--grid-color:${s.gridColor};--chart-border:${s.borderColor};--bar-width:${s.barWidth}%;--line-width:${s.lineWidth}px;--point-size:${s.pointSize}px;--legend-size:${s.legendSize}px;--donut-hole:${s.donutHole}%;--chart-primary:${colors[0]};--chart-secondary:${colors[1]};--chart-label-count:${Math.max(1,items.length)};`;
  let body='';
  if(type==='bar-vertical'){
    const tickVals=[1,.75,.5,.25,0];
    body=`<div class="academic-plot academic-column-plot ${s.showGrid?'with-grid':''}">${chartAxisTitle(s,'y')}<div class="column-scale">${s.showAxes?tickVals.map(t=>`<span style="top:${(1-t)*100}%">${chartMetricFormat(max*t,opt,s)}</span>`).join(''):''}</div><div class="visual-columns">${items.map((x,i)=>`<div class="visual-column-item"><div class="visual-column-value ${s.valuePosition==='inside'?'inside':''}">${chartValueLabel(x.value,opt,s)}</div><div class="visual-column-track"><i style="height:${clamp(x.value/max*100,4,100)}%;background:${colors[0]}"></i></div><div class="visual-column-name rotation-${s.labelRotation}" title="${esc(x.key)}">${esc(x.key)}</div></div>`).join('')}</div>${chartAxisTitle(s,'x')}</div>`;
  }else if(type==='line'||type==='area'){
    const pts=items,W=820,H=320,padL=82,padR=24,padT=34,padB=54,plotW=W-padL-padR,plotH=H-padT-padB;
    const coords=pts.map((x,i)=>{const px=pts.length===1?padL+plotW/2:padL+i*(plotW/(pts.length-1));const py=padT+(1-x.value/max)*plotH;return {x:px,y:py,item:x}});
    const areaPath=coords.length?`${padL},${H-padB} ${coords.map(p=>`${p.x},${p.y}`).join(' ')} ${coords.at(-1).x},${H-padB}`:'';
    const gradId=`areaGradient-${String(id).replace(/[^a-z0-9_-]/gi,'')}`;
    const ticks=[0,.25,.5,.75,1];
    const grid=ticks.map(t=>{const y=padT+(1-t)*plotH;return `${s.showGrid?`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" class="visual-line-grid"/>`:''}${s.showAxes?`<text x="${padL-12}" y="${y+4}" text-anchor="end" class="visual-line-tick">${esc(chartMetricFormat(max*t,opt,s))}</text>`:''}`}).join('');
    const valueLabels=s.showValues&&s.valuePosition!=='hidden'?coords.map((p,i)=>{const y=s.valuePosition==='inside'?p.y+18:p.y-11;return `<text x="${p.x}" y="${Math.max(12,Math.min(H-padB-4,y))}" text-anchor="middle" class="visual-line-value">${esc(chartMetricFormat(p.item.value,opt,s))}</text>`}).join(''):'';
    body=`<div class="academic-plot academic-line-plot">${chartAxisTitle(s,'y')}<div class="visual-line-wrap"><svg class="visual-line-svg" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"><defs>${type==='area'?`<linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${colors[0]}" stop-opacity="0.42"/><stop offset="48%" stop-color="${colors[0]}" stop-opacity="0.20"/><stop offset="100%" stop-color="${colors[0]}" stop-opacity="0.025"/></linearGradient>`:''}</defs>${grid}${s.showAxes?`<line x1="${padL}" y1="${H-padB}" x2="${W-padR}" y2="${H-padB}" class="visual-line-axis"/><line x1="${padL}" y1="${padT}" x2="${padL}" y2="${H-padB}" class="visual-line-axis"/>`:''}${type==='area'&&coords.length>1?`<polygon points="${areaPath}" class="visual-area-fill" fill="url(#${gradId})"/>`:''}${coords.length>1?`<polyline points="${coords.map(p=>`${p.x},${p.y}`).join(' ')}" class="visual-line-path" style="stroke:${colors[0]};stroke-width:${s.lineWidth}"/>`:''}${s.showPoints?coords.map(p=>`<circle cx="${p.x}" cy="${p.y}" r="${s.pointSize}" class="visual-line-point" style="fill:${s.plotBg};stroke:${colors[1]}"><title>${esc(p.item.key)}: ${esc(chartMetricFormat(p.item.value,opt,s))}</title></circle>`).join(''):''}${valueLabels}</svg><div class="visual-line-labels">${pts.map(x=>`<div class="rotation-${s.labelRotation}" title="${esc(x.key)}"><span>${esc(x.key)}</span></div>`).join('')}</div></div>${chartAxisTitle(s,'x')}</div>`;
  }else if(type==='donut'||type==='pie'){
    const parts=items.slice(0,10),total=parts.reduce((a,b)=>a+b.value,0);let cur=0;
    const arcs=parts.map((x,i)=>{const a=cur,b=cur+(total?x.value/total*100:0),mid=(a+b)/2;cur=b;return {x,i,a,b,mid}});
    const stops=arcs.map(o=>`${colors[o.i%colors.length]} ${o.a}% ${o.b}%`).join(',');
    const hole=type==='pie'?0:s.donutHole;
    const labels=s.showValues&&s.valuePosition!=='hidden'?arcs.map(o=>{const ang=(o.mid*3.6-90)*Math.PI/180,r=type==='pie'?31:37,x=50+Math.cos(ang)*r,y=50+Math.sin(ang)*r;return `<span class="visual-donut-value-label" style="left:${x}%;top:${y}%">${esc(chartMetricFormat(o.x.value,opt,s))}</span>`}).join(''):'';
    body=`<div class="visual-donut-layout legend-${s.legendPosition}"><div class="visual-donut ${type==='pie'?'is-pie':''}" style="background:${parts.length?`conic-gradient(${stops})`:'#eee'};--donut-hole:${hole}%">${type==='pie'?'':`<div><strong>${chartMetricFormat(total,opt,s)}</strong><span>Total do recorte exibido</span></div>`}${labels}</div>${s.showLegend?`<div class="visual-donut-list">${parts.map((x,i)=>`<div><i style="background:${colors[i%colors.length]}"></i><span title="${esc(x.key)}">${esc(x.key)}</span><b>${total?pct(x.value/total*100):'—'}</b>${s.showValues?`<small>${chartMetricFormat(x.value,opt,s)}</small>`:''}</div>`).join('')}</div>`:''}</div>`;
  }else if(type==='lollipop'){
    body=`<div class="visual-lollipop-list">${items.map((x,i)=>`<div class="visual-lollipop-row"><span>${esc(x.key)}</span><div class="visual-lollipop-track"><i style="width:${clamp(x.value/max*100,3,100)}%;background:${colors[0]}"></i><em style="left:${clamp(x.value/max*100,3,100)}%;background:${colors[1]};width:${s.pointSize*2}px;height:${s.pointSize*2}px"></em></div>${s.showValues?`<b>${chartMetricFormat(x.value,opt,s)}</b>`:''}</div>`).join('')}</div>`;
  }else if(type==='treemap'){
    const total=Math.max(1,items.reduce((a,b)=>a+b.value,0));
    body=`<div class="visual-treemap">${items.map((x,i)=>`<div class="treemap-cell" style="flex-grow:${Math.max(.08,x.value/total*100)};background:${colors[i%colors.length]}">${s.treemapText?`<strong>${esc(x.key)}</strong>`:''}${s.showValues?`<span>${chartMetricFormat(x.value,opt,s)}</span>`:''}</div>`).join('')}</div>`;
  }else{
    body=`<div class="academic-plot academic-bar-plot ${s.showGrid?'with-grid':''}">${chartAxisTitle(s,'x')}<div class="visual-chart-bars">${items.map((x,i)=>`<div class="visual-chart-row"><span class="visual-chart-rank">${i+1}</span><div class="visual-chart-name" title="${esc(x.key)}">${esc(x.key)}</div><div class="visual-chart-track"><i style="width:${clamp(x.value/max*100,3,100)}%;height:${Math.max(5,Math.round(s.barWidth/10))}px;background:${colors[0]}"></i></div>${s.showValues?`<b class="value-${s.valuePosition}">${chartMetricFormat(x.value,opt,s)}</b>`:''}</div>`).join('')}</div>${chartAxisTitle(s,'y')}</div>`;
  }
  el.innerHTML=`<figure class="visual-chart visual-chart-${type} tcc-chart ${s.showBorder?'show-chart-border':''}" style="${cssVars};text-align:left"><header class="academic-chart-head"><h3 style="text-align:${s.titleAlign}">${esc(title)}</h3><p style="text-align:${s.subtitleAlign}">${esc(subtitle)}</p></header>${body}${s.showSource?`<figcaption class="academic-chart-source" style="text-align:${s.sourceAlign}">${esc(s.sourceText)}</figcaption>`:''}</figure>`;
  enhanceAcronymHelp(el)
}

function chartFileName(id,ext){const opt=currentVisualOption(id);const raw=(chartSettings(id).title||academicChartTitle(id,opt)||'grafico').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-|-$/g,'').toLowerCase();return `${raw||'grafico-observatorio'}.${ext}`}
function cloneChartWithComputedStyles(node){const clone=node.cloneNode(true),src=[node,...node.querySelectorAll('*')],dst=[clone,...clone.querySelectorAll('*')];src.forEach((el,i)=>{const cs=getComputedStyle(el);let txt='';for(const prop of cs){if(prop.startsWith('-webkit-'))continue;txt+=`${prop}:${cs.getPropertyValue(prop)};`}dst[i]?.setAttribute('style',`${dst[i]?.getAttribute('style')||''};${txt}`)});return clone}
function chartSvgBlob(id){const fig=document.getElementById(id)?.querySelector('.visual-chart');if(!fig)throw new Error('Gráfico não encontrado');const rect=fig.getBoundingClientRect(),w=Math.max(640,Math.ceil(rect.width)),h=Math.max(420,Math.ceil(fig.scrollHeight||rect.height));const clone=cloneChartWithComputedStyles(fig);clone.style.width=`${w}px`;clone.style.height='auto';const html=new XMLSerializer().serializeToString(clone);const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><foreignObject width="100%" height="100%"><div xmlns="http://www.w3.org/1999/xhtml">${html}</div></foreignObject></svg>`;return {blob:new Blob([svg],{type:'image/svg+xml;charset=utf-8'}),w,h}}
function saveBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1200)}
async function downloadChart(id,format='png'){
  try{
    const pack=chartSvgBlob(id);
    if(format==='svg'){saveBlob(pack.blob,chartFileName(id,'svg'));return}
    const url=URL.createObjectURL(pack.blob),img=new Image();
    await new Promise((resolve,reject)=>{img.onload=resolve;img.onerror=reject;img.src=url});
    const scale=2,canvas=document.createElement('canvas');canvas.width=pack.w*scale;canvas.height=pack.h*scale;const ctx=canvas.getContext('2d');ctx.scale(scale,scale);ctx.fillStyle=chartSettings(id).imageBg||'#fff';ctx.fillRect(0,0,pack.w,pack.h);ctx.drawImage(img,0,0,pack.w,pack.h);URL.revokeObjectURL(url);
    const mime=format==='jpg'?'image/jpeg':'image/png',ext=format==='jpg'?'jpg':'png';canvas.toBlob(blob=>blob&&saveBlob(blob,chartFileName(id,ext)),mime,format==='jpg'?.95:1)
  }catch(err){console.error(err);toast('Não foi possível exportar o gráfico.')}
