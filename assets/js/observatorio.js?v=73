/* REPORTS */

function reportListText(values,formatter=v=>v,max=4){
  if(!values?.length)return '';
  const labels=values.map(formatter);
  if(labels.length<=max)return labels.join(', ');
  return `${labels.slice(0,max).join(', ')} e mais ${fmt.format(labels.length-max)}`;
}
function reportFilterInfo(rows){
  const regionText=state.region.length?reportListText(state.region):'Todas as regiões do Brasil';
  const ufText=state.uf.length?reportListText(state.uf,fullUf):`Todas as ${fmt.format(uniq(rows.map(r=>r.uf)).length)} UFs presentes no recorte`;
  const municipioText=state.municipio.length?reportListText(state.municipio,filterDefs.municipio.label):`Todos os ${fmt.format(rows.length)} municípios que atendem aos demais filtros`;
  const fcuText=!state.fcu.length||state.fcu.length>1?'Com e sem FCU':state.fcu[0]==='1'?'Somente municípios com FCU identificada':'Somente municípios sem FCU identificada';
  const modalidadeText=state.modalidade.length?reportListText(state.modalidade):'Todas as modalidades do MCMV disponíveis na base';
  const active=[];
  if(state.region.length)active.push('região');
  if(state.uf.length)active.push('UF');
  if(state.municipio.length)active.push('município');
  if(state.fcu.length===1)active.push('presença de FCU');
  if(state.modalidade.length)active.push('modalidade do MCMV');
  const opening=active.length
    ? `O recorte atual utiliza filtros de ${active.join(', ').replace(/, ([^,]*)$/, ' e $1')}. Por isso, todos os indicadores, mapas, rankings e tabelas deste relatório consideram somente os municípios que permanecem após a aplicação conjunta desses critérios.`
    : `Nenhum filtro específico foi aplicado. O relatório apresenta o panorama mais amplo disponível na base integrada do Observatório, preservando a referência territorial e temporal de 2022.`;
  const logic=`Os filtros funcionam de forma combinada: quando mais de um critério é selecionado, o município precisa atender simultaneamente a todos eles para entrar nos cálculos. Assim, alterar qualquer filtro pode mudar totais, médias, rankings e percentuais.`;
  return {regionText,ufText,municipioText,fcuText,modalidadeText,opening,logic,activeCount:active.length};
}
function reportNarrative(rows,tot){
  const f=reportFilterInfo(rows);
  const reach=Number.isFinite(+tot.reach)?pct(tot.reach):'—';
  const mcmvMun=fmt.format(tot.present||0);
  const fcuMun=fmt.format(tot.withFcu||0);
  const mcmvShare=rows.length?pct((tot.present||0)/rows.length*100):'—';
  const fcuShare=rows.length?pct((tot.withFcu||0)/rows.length*100):'—';
  const synthesis=`O recorte reúne ${fmt.format(rows.length)} municípios e uma população total de ${compact.format(tot.pop)} pessoas. Até 2022, a base registra ${compact.format(tot.uh)} unidades habitacionais (UH) contratadas pelo Minha Casa, Minha Vida (MCMV), distribuídas em ${mcmvMun} municípios (${mcmvShare} do recorte). A estimativa de pessoas potencialmente beneficiadas é de ${compact.format(tot.benef)}, correspondente a um alcance potencial de ${reach} da população do recorte.`;
  const territory=`Também foram identificadas ${fmt.format(tot.fcus)} Favelas e Comunidades Urbanas (FCUs), presentes em ${fcuMun} municípios (${fcuShare} do recorte). Esses dados são analisados em conjunto com população, Produto Interno Bruto (PIB) e indicadores de infraestrutura urbana para permitir uma leitura territorial integrada das políticas públicas.`;
  const caution=`A expressão “pessoas potencialmente beneficiadas” representa uma estimativa analítica construída a partir das unidades habitacionais e não uma contagem administrativa de beneficiários efetivamente atendidos. Rankings e médias devem ser interpretados junto à cobertura e às limitações descritas na metodologia.`;
  return {...f,synthesis,territory,caution};
}

