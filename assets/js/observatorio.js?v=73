  if(el.classList?.contains('filter-control'))return FILTER_HELP[el.dataset.filter]||'Filtro do recorte atual. Ao alterar este campo, o site atualiza automaticamente mapas, gráficos, rankings e indicadores.';
  if(el.classList?.contains('filter-summary'))return 'Resumo textual do recorte atual. Mostra, em uma frase, quais filtros estão ativos e quantos municípios fazem parte da seleção.';
  if(el.id==='clearFilters'||el.classList?.contains('clear-filters'))return 'Remove todas as seleções feitas nos filtros e retorna o Observatório ao recorte geral.';
  if(el.id==='themeToggle')return 'Ativa ou desativa o modo escuro, mudando o tema visual da interface para facilitar a leitura em ambientes com pouca luz.';
  if(el.id==='contrastToggle')return 'Ativa ou desativa o alto contraste, aumentando a diferença entre fundo e elementos visuais para melhorar a acessibilidade.';
  if(el.id==='openGuide'||el.classList?.contains('guide-trigger'))return 'Abre um guia rápido de uso para novos usuários, explicando o foco do Observatório e como explorar os dados.';
  if(el.matches?.('.preview-actions button')){
    const txt=(el.textContent||'').replace(/\s+/g,' ').trim();
    if(/pdf/i.test(txt))return 'Gera uma versão do relatório pronta para impressão ou exportação em PDF.';
    if(/csv/i.test(txt))return 'Exporta o recorte atual em formato CSV para análise em planilhas ou outros sistemas.';
    if(/downloads/i.test(txt))return 'Abre a área de downloads do Observatório, onde estão as bases e documentos disponíveis.';
    if(/metodologia/i.test(txt))return 'Abre a área de metodologia, com explicação das fontes, fórmulas e limites analíticos.';
  }
  const txt=(el.querySelector?.('.card-head h2,.card-head h3,h2,h3,h4,.kpi-copy small,.filter-copy small,strong,span')?.textContent||el.textContent||'').replace(/\s+/g,' ').trim();
  if(!txt)return'';
  const rule=CONTEXT_HELP_RULES.find(r=>r.match.test(txt));
  return rule?.text||'Este elemento faz parte da leitura do recorte atual e ajuda a interpretar os dados territoriais selecionados.';
