function donutCard(groups,total,label='UH'){let cur=0;const stops=groups.map((g,i)=>{const a=cur,b=cur+(total?g.value/total*100:0);cur=b;return `${palette[i%palette.length]} ${a}% ${b}%`}).join(',');const totalText=fmt.format(Math.round(total));const fitClass=totalText.length>=9?'fit-xxl':totalText.length>=7?'fit-xl':totalText.length>=5?'fit-lg':'';return `<div class="donut-wrap"><div class="donut" style="background:${groups.length?`conic-gradient(${stops})`:'#eee'}"><div class="donut-center"><strong class="chart-center-value ${fitClass}" title="${esc(totalText)}">${totalText}</strong><span>${label}</span></div></div><div class="donut-legend">${groups.map((g,i)=>`<div class="donut-item"><i style="background:${palette[i%palette.length]}"></i><span>${esc(g.key)}<small>${fmt.format(Math.round(g.value))} ${label}</small></span><b>${total?pct(g.value/total*100):'—'}</b></div>`).join('')}</div></div>`}

