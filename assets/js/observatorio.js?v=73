    const typeSelect=wrap.querySelector(`[data-chart-type-select="${id}"]`);const edit=wrap.querySelector(`[data-chart-edit="${id}"]`);if(typeSelect){const allowed=allowedChartTypes(currentVisualOption(id));if(!allowed.includes(visualChartTypes[id]))visualChartTypes[id]=allowed[0];typeSelect.innerHTML=allowed.map(t=>`<option value="${t}">${chartTypeLabels[t]}</option>`).join('');typeSelect.value=visualChartTypes[id];typeSelect.hidden=visualModes[id]!=='chart'}if(edit)edit.hidden=visualModes[id]!=='chart';
    wrap.querySelectorAll(`[data-visual-target="${id}"]`).forEach(b=>b.classList.toggle('active',b.dataset.visualMode===visualModes[id]));
    card?.classList.toggle('visual-chart-mode',visualModes[id]==='chart');
