      const sw=document.createElement('div');sw.className='visual-switch';sw.innerHTML=`<button type="button" data-visual-target="${id}" data-visual-mode="map">Mapa</button><button type="button" data-visual-target="${id}" data-visual-mode="chart">Gráfico</button>`;
